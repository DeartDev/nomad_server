# ===========================================================================
#  nomad_server — variables del despliegue
# ===========================================================================
#  Esta es la ÚNICA fuente de verdad de los valores concretos del servidor.
#  Toda la documentación en docs/ usa ${VARIABLES} en lugar de valores fijos:
#  si cambias algo aquí, la documentación sigue siendo correcta.
#
#  Uso:
#      cp config/servidor.env.example config/servidor.env
#      chmod 600 config/servidor.env
#      $EDITOR config/servidor.env
#
#  config/servidor.env está en .gitignore y NO debe versionarse.
#  Este archivo (.example) sí se versiona, solo con valores de ejemplo.
#
#  Formato: KEY="valor". Sin espacios alrededor del "=". Todo entre comillas.
#  Los scripts en scripts/ cargan este archivo y abortan si falta una variable
#  obligatoria (marcadas con [OBLIGATORIA]).
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. IDENTIDAD DEL SERVIDOR                        (docs/04_primer_arranque…)
# ---------------------------------------------------------------------------

# [OBLIGATORIA] Nombre corto del equipo. Minúsculas, sin espacios ni tildes.
# Se usa en /etc/hostname, en el prompt, en Tailscale y en los backups.
SERVIDOR_HOSTNAME="nomad"

# Sufijo de dominio de la red local. Muchos routers domésticos usan ".lan"
# o ".home". Solo tiene efecto dentro de tu red; no es un dominio de internet.
# Se usa para el FQDN en /etc/hosts.
SERVIDOR_DOMINIO_LOCAL="lan"

# [OBLIGATORIA] Zona horaria IANA. Lista completa: timedatectl list-timezones
SERVIDOR_ZONA_HORARIA="America/Bogota"

# Locale del sistema. Se recomienda mantener el sistema en C.UTF-8 o en_US.UTF-8
# aunque tú trabajes en español: los mensajes de error en inglés son mucho más
# fáciles de buscar en la documentación oficial.
SERVIDOR_LOCALE="en_US.UTF-8"


# ---------------------------------------------------------------------------
# 2. USUARIO ADMINISTRADOR                         (docs/05_usuarios_y_acceso…)
# ---------------------------------------------------------------------------

# [OBLIGATORIA] Usuario no privilegiado con sudo. NUNCA se administra como root.
ADMIN_USUARIO="deart"

# Ruta al archivo de clave pública SSH en TU EQUIPO CLIENTE (no en el servidor).
# Es la clave que se instalará en ~/.ssh/authorized_keys del servidor.
# Debe ser una clave pública (.pub). Nunca copies aquí la clave privada.
ADMIN_SSH_CLAVE_PUBLICA="$HOME/.ssh/id_ed25519_nomad.pub"


# ---------------------------------------------------------------------------
# 3. RED LOCAL                                              (docs/06_red_y_firewall)
# ---------------------------------------------------------------------------

# [OBLIGATORIA] Rango de tu red local en notación CIDR.
# Averígualo en tu equipo actual con:  ip -4 addr show
# Valores típicos: 192.168.1.0/24, 192.168.0.0/24, 10.0.0.0/24
LAN_CIDR="192.168.1.0/24"

# [OBLIGATORIA] IP fija que tendrá el servidor. Debe estar DENTRO de LAN_CIDR y
# FUERA del rango DHCP del router (o reservada en el router para su MAC).
LAN_IP="192.168.1.50"

# Prefijo de red de LAN_IP (24 = máscara 255.255.255.0). Coherente con LAN_CIDR.
LAN_PREFIJO="24"

# [OBLIGATORIA] Puerta de enlace: la IP de tu router.
LAN_GATEWAY="192.168.1.1"

# Servidores DNS, separados por espacios. Por defecto el router; puedes usar
# resolutores públicos si prefieres (1.1.1.1, 9.9.9.9).
LAN_DNS="192.168.1.1 1.1.1.1"

# Nombre de la interfaz de red cableada del servidor.
# Se descubre en el propio servidor con:  ip -br link
# En Debian los nombres son predecibles: enp3s0, eno1, enx… (NO eth0).
# Déjalo vacío ("") para que los scripts intenten detectarla automáticamente.
LAN_INTERFAZ=""

# Puerto de SSH. Se mantiene el 22 estándar: el servicio nunca se expone a
# internet, así que cambiar el puerto no aporta seguridad real y sí confusión.
SSH_PUERTO="22"


# ---------------------------------------------------------------------------
# 4. TAILSCALE                                                 (docs/08_tailscale)
# ---------------------------------------------------------------------------

# Nombre del nodo dentro de tu tailnet. Suele coincidir con SERVIDOR_HOSTNAME.
TS_HOSTNAME="nomad"

# Rango de direcciones de Tailscale (CGNAT). Es fijo para todas las tailnets;
# solo cámbialo si sabes exactamente por qué. Lo usa el firewall.
TS_CIDR="100.64.0.0/10"

# Nombre de la interfaz que crea Tailscale. Fijo en Linux.
TS_INTERFAZ="tailscale0"


# ---------------------------------------------------------------------------
# 5. DOCKER                                                       (docs/09_docker)
# ---------------------------------------------------------------------------

# Red Docker compartida entre Traefik, cloudflared y los proyectos publicados.
# Ningún contenedor publica puertos al host: se comunican por esta red.
DOCKER_RED_PROXY="proxy"

# Subred de la red 'proxy'. Debe NO solaparse con LAN_CIDR ni con TS_CIDR.
DOCKER_RED_PROXY_SUBRED="172.20.0.0/16"

# Red aislada entre el intermediario del socket de Docker y quienes necesitan
# consultarlo (Traefik y Dozzle). Se crea como 'internal': sin salida a
# internet. Ver docs/10_traefik.md § 3.2.
DOCKER_RED_SOCKET="socket"
DOCKER_RED_SOCKET_SUBRED="172.19.0.0/24"

# Directorio raíz de los proyectos desplegados. Un subdirectorio por proyecto.
DATOS_RAIZ="/srv"

# Tamaño y número de archivos de log por contenedor (rotación en daemon.json).
DOCKER_LOG_MAX_SIZE="10m"
DOCKER_LOG_MAX_FILE="3"


# ---------------------------------------------------------------------------
# 6. PUBLICACIÓN WEB: TRAEFIK + CLOUDFLARE TUNNEL   (docs/10_traefik, docs/11_…)
# ---------------------------------------------------------------------------

# Dominio público bajo el cual se publican los proyectos como subdominios.
# Déjalo con el valor de ejemplo hasta que adquieras el dominio real:
# la infraestructura se monta igual y solo hay que cambiar este valor.
DOMINIO_PUBLICO="ejemplo.com"

# Subdominio del panel de Traefik. Solo accesible por Tailscale, nunca por el
# túnel público.
TRAEFIK_DASHBOARD_HOST="traefik.${SERVIDOR_HOSTNAME}.${SERVIDOR_DOMINIO_LOCAL}"

# Dirección del host donde se publica el punto de entrada INTERNO de Traefik
# (panel y herramientas de operación). NUNCA debe ser 0.0.0.0.
#
#   127.0.0.1        → solo desde el propio servidor. Se llega con un túnel:
#                      ssh -L 8080:127.0.0.1:8080 nomad
#   100.x.y.z        → la IP de Tailscale del servidor (tras el capítulo 08).
#                      Permite abrir el panel desde cualquier dispositivo de tu
#                      tailnet, incluido el móvil, sin túneles.
#
# Empieza con 127.0.0.1 y cámbialo por tu IP de Tailscale cuando termines el
# capítulo 08. Obtén esa IP con:  tailscale ip -4
TRAEFIK_BIND_INTERNA="127.0.0.1"

# Puerto del punto de entrada interno en el host.
TRAEFIK_PUERTO_INTERNA="8080"

# Nombre del túnel en Cloudflare. Se crea una sola vez.
CF_TUNEL_NOMBRE="nomad-tunnel"

# UUID del túnel. Lo devuelve 'cloudflared tunnel create' en el capítulo 11.
# Déjalo vacío hasta entonces.
CF_TUNEL_ID=""

# Directorio donde viven la configuración y las credenciales del túnel.
# El archivo <UUID>.json de dentro es un secreto: nunca se versiona.
CF_CONFIG_DIR="${DATOS_RAIZ}/cloudflared"


# ---------------------------------------------------------------------------
# 7. RESPALDOS                                            (docs/14_respaldos_restic)
# ---------------------------------------------------------------------------

# UUID del sistema de archivos del disco USB de respaldo.
# Se obtiene con:  lsblk -o NAME,UUID,SIZE,FSTYPE
# Se monta por UUID y no por /dev/sdX porque las letras cambian de orden.
RESTIC_USB_UUID=""

# Punto de montaje del disco de respaldo.
RESTIC_USB_MOUNT="/mnt/respaldo"

# Repositorio restic local (dentro del disco USB).
RESTIC_REPO_LOCAL="${RESTIC_USB_MOUNT}/restic/${SERVIDOR_HOSTNAME}"

# Repositorio remoto OPCIONAL (segunda copia fuera de casa).
# Formatos admitidos: s3:…, b2:…, rclone:…, sftp:…
# Déjalo vacío para respaldar solo en local.
RESTIC_REPO_REMOTO=""

# Archivo que contiene la contraseña del repositorio restic EN EL SERVIDOR.
# Permisos 600, propiedad de root. NUNCA se versiona.
# Si pierdes esta contraseña, los respaldos son irrecuperables: guárdala también
# en tu gestor de contraseñas.
RESTIC_PASSWORD_FILE="/root/.restic-password"

# Política de retención (cuántos snapshots conservar de cada tipo).
RESTIC_RETENCION_DIARIOS="7"
RESTIC_RETENCION_SEMANALES="4"
RESTIC_RETENCION_MENSUALES="6"

# Hora diaria del respaldo automático (formato de systemd OnCalendar).
RESTIC_HORA="03:30"

# URL de aviso de Uptime Kuma (monitor de tipo Push) para saber si el respaldo
# nocturno se ejecutó. Un respaldo que falla en silencio es peor que no tener
# respaldo, porque crees que estás cubierto. Déjala vacía para no avisar.
# Se obtiene al crear el monitor: docs/14_respaldos_restic.md § 5 paso 8
RESTIC_PUSH_URL=""


# ---------------------------------------------------------------------------
# 8. OBSERVABILIDAD                                       (docs/13_observabilidad)
# ---------------------------------------------------------------------------

# Subdominios internos de las herramientas de operación. Solo por Tailscale.
DOZZLE_HOST="logs.${SERVIDOR_HOSTNAME}.${SERVIDOR_DOMINIO_LOCAL}"
UPTIME_KUMA_HOST="estado.${SERVIDOR_HOSTNAME}.${SERVIDOR_DOMINIO_LOCAL}"


# ---------------------------------------------------------------------------
# 9. INSTALACIÓN (solo se usan durante el montaje inicial)
# ---------------------------------------------------------------------------

# Disco donde se instalará Debian. ¡SE BORRARÁ POR COMPLETO!
# Identifícalo con:  lsblk -o NAME,SIZE,MODEL,SERIAL
# Usa la ruta estable por ID cuando sea posible:
#   /dev/disk/by-id/ata-Marca_Modelo_Serial
DISCO_DESTINO="/dev/disk/by-id/CAMBIAME"

# Réplica (mirror) de Debian más cercana. Lista: https://www.debian.org/mirror/list
DEBIAN_MIRROR="deb.debian.org"

# Nombre en clave de la versión de Debian documentada.
DEBIAN_SUITE="trixie"
