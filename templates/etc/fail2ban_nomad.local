# ===========================================================================
#  nomad_server — configuración de fail2ban
#  Destino  : /etc/fail2ban/jail.d/nomad.local
#  Generado por scripts/05_ssh.sh
#  Capítulo : docs/05_usuarios_y_acceso_ssh.md § 3.7
#
#  CÓMO APLICARLA A MANO (equivalente a lo que hace el script)
#
#      cd ~/nomad_server
#      source scripts/lib/entorno.sh
#      nomad_diff etc/fail2ban_nomad.local /etc/fail2ban/jail.d/nomad.local
#      sudo cp -a /etc/fail2ban/jail.d/nomad.local \
#          /etc/fail2ban/jail.d/nomad.local.bak-$(date +%Y%m%d-%H%M%S) 2>/dev/null || true
#      nomad_plantilla etc/fail2ban_nomad.local \
#          | sudo tee /etc/fail2ban/jail.d/nomad.local >/dev/null
#      sudo chmod 644 /etc/fail2ban/jail.d/nomad.local
#
#  Y después, para que tenga efecto:
#      sudo systemctl restart fail2ban
#
#  Detalle: templates/README.md y docs/98_variables_y_entorno.md § 4.3
# ===========================================================================

[DEFAULT]
# Nunca bloquear a los equipos de la red local ni a los de la tailnet:
# bloquearte a ti mismo por teclear mal una contraseña sería un mal final.
ignoreip = 127.0.0.1/8 ::1 ${LAN_CIDR} ${TS_CIDR}

bantime  = 1h
findtime = 10m
maxretry = 5

# Una instalación mínima de Debian 13 NO lleva rsyslog: /var/log/auth.log no
# existe y los registros están solo en journald. Sin esta línea, fail2ban no
# encuentra nada que leer y no bloquea a nadie, en silencio.
backend = systemd

# El cortafuegos de este servidor es nftables (capítulo 06). Sin esto se
# usaría iptables, cuyas reglas no aparecerían al inspeccionar el cortafuegos.
banaction = nftables-multiport
banaction_allports = nftables-allports

[sshd]
enabled = true
port    = ${SSH_PUERTO}
