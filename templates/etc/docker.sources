# ===========================================================================
#  Repositorio de Docker CE — formato deb822
#  Destino  : /etc/apt/sources.list.d/docker.sources
#  Generado por scripts/09_docker.sh
#  Capítulo : docs/09_docker.md § 3.1
#
#  Se usa el repositorio oficial de Docker y no el paquete 'docker.io' de
#  Debian: este último se queda varias versiones atrás y no incluye el plugin
#  'compose' v2.
#
#  CÓMO APLICARLA A MANO (equivalente a lo que hace el script)
#
#      cd ~/nomad_server
#      source scripts/lib/entorno.sh
#      nomad_diff etc/docker.sources /etc/apt/sources.list.d/docker.sources
#      sudo cp -a /etc/apt/sources.list.d/docker.sources \
#          /etc/apt/sources.list.d/docker.sources.bak-$(date +%Y%m%d-%H%M%S) 2>/dev/null || true
#      nomad_plantilla etc/docker.sources \
#          | sudo tee /etc/apt/sources.list.d/docker.sources >/dev/null
#      sudo chmod 644 /etc/apt/sources.list.d/docker.sources
#
#  Y después, para que tenga efecto:
#      sudo apt update
#
#  Detalle: templates/README.md y docs/98_variables_y_entorno.md § 4.3
# ===========================================================================

Types: deb
URIs: https://download.docker.com/linux/debian
Suites: ${DEBIAN_SUITE}
Components: stable
Architectures: amd64
Signed-By: /etc/apt/keyrings/docker.asc
