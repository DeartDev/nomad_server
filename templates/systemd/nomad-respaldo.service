# ===========================================================================
#  nomad_server — servicio de respaldo
#  Destino  : /etc/systemd/system/nomad-respaldo.service
#  Generado por scripts/14_restic.sh
#  Capítulo : docs/14_respaldos_restic.md
#
#  CÓMO APLICARLA A MANO (equivalente a lo que hace el script)
#
#      cd ~/nomad_server
#      source scripts/lib/entorno.sh
#      nomad_diff systemd/nomad-respaldo.service /etc/systemd/system/nomad-respaldo.service
#      sudo mkdir -p /var/backups/nomad/config$(dirname /etc/systemd/system/nomad-respaldo.service)
#      sudo cp -a /etc/systemd/system/nomad-respaldo.service \
#          /var/backups/nomad/config/etc/systemd/system/nomad-respaldo.service.bak-$(date +%Y%m%d-%H%M%S)
#      nomad_plantilla systemd/nomad-respaldo.service \
#          | sudo tee /etc/systemd/system/nomad-respaldo.service >/dev/null
#      sudo chmod 644 /etc/systemd/system/nomad-respaldo.service
#
#  Y después, para que tenga efecto:
#      sudo systemctl daemon-reload
#
#  Detalle: templates/README.md y docs/98_variables_y_entorno.md § 4.3
# ===========================================================================

[Unit]
Description=Respaldo del sistema con restic
Documentation=file:///home/${ADMIN_USUARIO}/nomad_server/docs/14_respaldos_restic.md

# Para el manifiesto de imágenes hace falta que Docker responda. 'Wants' y no
# 'Requires': si Docker estuviera parado, el respaldo de los archivos sigue
# mereciendo la pena.
Wants=docker.service
After=docker.service network-online.target

# La dependencia del disco USB NO está aquí, sino en el añadido
# nomad-respaldo.service.d/10-disco-usb.conf, que scripts/14_restic.sh instala
# solo si hay disco. Ponerla en la unidad base dejaría el respaldo esperando
# para siempre un montaje inexistente en las instalaciones que respaldan solo
# a un destino remoto.

[Service]
Type=oneshot
ExecStart=/usr/local/bin/nomad-respaldo.sh

# Credenciales del repositorio remoto: B2_ACCOUNT_ID, AWS_ACCESS_KEY_ID y
# compañía. El '-' inicial hace que la unidad arranque igual si el archivo no
# existe, que es el caso cuando no hay destino remoto.
#
# Sin esta línea, 'restic copy' al remoto falla SIEMPRE bajo el temporizador
# —funciona solo si lanzas el script a mano tras cargar el archivo—, y el fallo
# queda enterrado en el registro mientras el respaldo local se da por bueno.
EnvironmentFile=-/etc/nomad/restic-remoto.env

# Prioridad baja: el respaldo no debe competir con los servicios.
Nice=19
IOSchedulingClass=idle

# Un respaldo que se eterniza acaba solapándose con el siguiente.
TimeoutStartSec=4h

# --- Aislamiento -----------------------------------------------------------
# El proceso necesita leer todo el sistema, pero no necesita escribir en casi
# ningún sitio.
ProtectSystem=strict

# 'CacheDirectory' crea /var/cache/restic si no existe y lo hace escribible.
# Ponerlo en ReadWritePaths NO valía: systemd se niega a arrancar un servicio
# cuyo ReadWritePaths apunta a algo inexistente, y falla en la fase de
# espacios de nombres, ANTES de ejecutar una sola línea del script. El
# respaldo manual seguía funcionando —no pasa por systemd— así que el fallo
# solo se veía en el journal, cada noche.
CacheDirectory=restic
Environment=RESTIC_CACHE_DIR=/var/cache/restic

# El guion inicial evita el mismo problema si el directorio aún no existe.
# El disco USB, si lo hay, lo añade el fichero 10-disco-usb.conf.
ReadWritePaths=-/var/backups/nomad
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
