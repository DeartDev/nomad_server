# ===========================================================================
#  nomad_server — servicio de respaldo
#  Destino  : /etc/systemd/system/nomad-respaldo.service
#  Generado por scripts/14_restic.sh
#  Capítulo : docs/14_respaldos_restic.md
#
#  CÓMO APLICARLA A MANO (equivalente a lo que hace el script)
#
#      cd ~/nomad_server
#      source scripts/lib/entorno.sh
#      nomad_diff systemd/nomad-respaldo.service /etc/systemd/system/nomad-respaldo.service
#      sudo cp -a /etc/systemd/system/nomad-respaldo.service \
#          /etc/systemd/system/nomad-respaldo.service.bak-$(date +%Y%m%d-%H%M%S) 2>/dev/null || true
#      nomad_plantilla systemd/nomad-respaldo.service \
#          | sudo tee /etc/systemd/system/nomad-respaldo.service >/dev/null
#      sudo chmod 644 /etc/systemd/system/nomad-respaldo.service
#
#  Y después, para que tenga efecto:
#      sudo systemctl daemon-reload
#
#  Detalle: templates/README.md y docs/98_variables_y_entorno.md § 4.3
# ===========================================================================

[Unit]
Description=Respaldo con restic al disco USB
Documentation=file:///home/${ADMIN_USUARIO}/nomad_server/docs/14_respaldos_restic.md

# El respaldo necesita el disco montado y, para el manifiesto de imágenes,
# que Docker responda. 'Wants' y no 'Requires': si Docker estuviera parado,
# el respaldo de los archivos sigue mereciendo la pena.
RequiresMountsFor=${RESTIC_USB_MOUNT}
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/nomad-respaldo.sh

# Prioridad baja: el respaldo no debe competir con los servicios.
Nice=19
IOSchedulingClass=idle

# Un respaldo que se eterniza acaba solapándose con el siguiente.
TimeoutStartSec=4h

# --- Aislamiento -----------------------------------------------------------
# El proceso necesita leer todo el sistema, pero no necesita escribir en casi
# ningún sitio.
ProtectSystem=strict
ReadWritePaths=${RESTIC_USB_MOUNT} /var/backups/nomad /var/cache/restic
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
