# ===========================================================================
#  nomad_server — temporizador del respaldo
#  Destino  : /etc/systemd/system/nomad-respaldo.timer
#  Generado por scripts/14_restic.sh
#  Capítulo : docs/14_respaldos_restic.md
# ===========================================================================

[Unit]
Description=Respaldo diario con restic

[Timer]
OnCalendar=*-*-* ${RESTIC_HORA}:00

# Si el servidor estaba apagado a la hora prevista, ejecutar el respaldo en
# cuanto arranque. Sin esto, un servidor apagado esa noche se queda sin copia
# y nadie se entera.
Persistent=true

# Repartir el arranque en un margen de 15 minutos: evita que el respaldo
# coincida exactamente con otras tareas nocturnas.
RandomizedDelaySec=15min

# Esperar a que el disco USB esté disponible.
Unit=nomad-respaldo.service

[Install]
WantedBy=timers.target
