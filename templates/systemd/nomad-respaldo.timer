# ===========================================================================
#  nomad_server — temporizador del respaldo
#  Destino  : /etc/systemd/system/nomad-respaldo.timer
#  Generado por scripts/14_restic.sh
#  Capítulo : docs/14_respaldos_restic.md
#
#  CÓMO APLICARLA A MANO (equivalente a lo que hace el script)
#
#      cd ~/nomad_server
#      source scripts/lib/entorno.sh
#      nomad_diff systemd/nomad-respaldo.timer /etc/systemd/system/nomad-respaldo.timer
#      sudo mkdir -p /var/backups/nomad/config$(dirname /etc/systemd/system/nomad-respaldo.timer)
#      sudo cp -a /etc/systemd/system/nomad-respaldo.timer \
#          /var/backups/nomad/config/etc/systemd/system/nomad-respaldo.timer.bak-$(date +%Y%m%d-%H%M%S)
#      nomad_plantilla systemd/nomad-respaldo.timer \
#          | sudo tee /etc/systemd/system/nomad-respaldo.timer >/dev/null
#      sudo chmod 644 /etc/systemd/system/nomad-respaldo.timer
#
#  Y después, para que tenga efecto:
#      sudo systemctl daemon-reload && sudo systemctl enable --now nomad-respaldo.timer
#
#  Detalle: templates/README.md y docs/98_variables_y_entorno.md § 4.3
# ===========================================================================

[Unit]
Description=Respaldo diario con restic

[Timer]
OnCalendar=*-*-* ${RESTIC_HORA}:00

# Si el servidor estaba apagado a la hora prevista, ejecutar el respaldo en
# cuanto arranque. Sin esto, un servidor apagado esa noche se queda sin copia
# y nadie se entera.
Persistent=true

# Repartir el arranque en un margen de 15 minutos: evita que el respaldo
# coincida exactamente con otras tareas nocturnas.
RandomizedDelaySec=15min

# Esperar a que el disco USB esté disponible.
Unit=nomad-respaldo.service

[Install]
WantedBy=timers.target
