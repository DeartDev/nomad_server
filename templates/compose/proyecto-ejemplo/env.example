# ===========================================================================
#  nomad_server — variables de un proyecto
#  Destino  : ${DATOS_RAIZ}/<proyecto>/.env
#  Capítulo : docs/12_despliegue_de_proyectos.md § 3.4
#
#  CÓMO SE USA
#      cp .env.example .env
#      chmod 600 .env
#      $EDITOR .env
#
#  Para obtenerlo ya con el dominio y la zona horaria de tu servidor:
#
#      cd ~/nomad_server
#      source scripts/lib/entorno.sh
#      PROYECTO=mi-proyecto
#      nomad_plantilla compose/proyecto-ejemplo/env.example \
#          > ${DATOS_RAIZ}/${PROYECTO}/.env.example
#
#  NO CONFUNDIR ESTE ARCHIVO CON config/servidor.env:
#      config/servidor.env       describe el SERVIDOR. Se carga en tu shell con
#                                'source scripts/lib/entorno.sh'.
#      <proyecto>/.env           describe esta APLICACIÓN. NO se carga en tu
#                                shell: lo lee Docker Compose al levantarla.
#  Ver docs/12_despliegue_de_proyectos.md § 4.3
#
#  El archivo .env NUNCA se versiona: contiene contraseñas y claves de API.
#  El .env.example SÍ se versiona, con valores ficticios, para que se sepa qué
#  variables hacen falta.
#
#  Genera las contraseñas al azar, no las inventes:
#      openssl rand -base64 32
# ===========================================================================

# --- Aplicación ------------------------------------------------------------
NODE_ENV=production
TZ=${SERVIDOR_ZONA_HORARIA}

# URL pública del proyecto. Muchas aplicaciones la necesitan para generar
# enlaces absolutos y para las redirecciones de autenticación.
APP_URL=https://ejemplo.${DOMINIO_PUBLICO}

# Clave de sesión o de firma. Genérala con: openssl rand -base64 32
APP_SECRET=CAMBIAME

# --- Base de datos ---------------------------------------------------------
POSTGRES_USER=proyecto
POSTGRES_PASSWORD=CAMBIAME
POSTGRES_DB=proyecto

# Cadena de conexión. El nombre 'db' es el del servicio en docker-compose.yml:
# lo resuelve el DNS interno de Docker dentro de la red 'interna'.
DATABASE_URL=postgresql://proyecto:CAMBIAME@db:5432/proyecto

# --- Servicios externos ----------------------------------------------------
# Claves de API, credenciales SMTP, etc. Una por línea, sin comillas.
#SMTP_HOST=
#SMTP_USER=
#SMTP_PASSWORD=
